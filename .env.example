# Copy to .env and adjust. Never commit .env.
#
# Every name here maps to a field on aqf.config.Settings via the AQF_ prefix.
# A variable that does not map to a field is ignored silently, so keep them in
# step with the class.

# --- Environment ---
AQF_ENV=development
AQF_LOG_LEVEL=INFO

# --- Data ---
AQF_DATA_DIR=data
# The UCI Air Quality archive, downloaded by scripts/download_data.py.
AQF_DATASET_URL=https://archive.ics.uci.edu/static/public/360/air+quality.zip

# --- Training ---
# Threads TensorFlow may use. Left unset it takes every core, which makes the
# fit-time column meaningless on a shared machine.
AQF_N_THREADS=4
